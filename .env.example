# KogniSync Scaffolding Configuration Template
PROJECT_NAME=KogniSync
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=kognisync
POSTGRES_PASSWORD=kognisync_pass
POSTGRES_DB=kognisync_db
DATABASE_URL=postgresql+asyncpg://kognisync:kognisync_pass@localhost:5434/kognisync_db

# Redis Configuration (Distributed Holds & Caching)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.5-flash-lite

# Google Maps / Routes API Configuration (Optional)
# When GOOGLE_ROUTES_ENABLED is True and a valid GOOGLE_MAPS_API_KEY is supplied,
# KogniSync will enrich road journey segments using the Google Routes API v2.
# When disabled (default) or key is absent, KogniSync seamlessly uses deterministic geographic routing.
GOOGLE_ROUTES_ENABLED=False
GOOGLE_MAPS_API_KEY=
