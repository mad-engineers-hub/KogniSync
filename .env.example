# KogniSync Scaffolding Configuration Template
PROJECT_NAME=KogniSync
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=kognisync
POSTGRES_PASSWORD=kognisync_pass
POSTGRES_DB=kognisync_db
DATABASE_URL=postgresql+asyncpg://kognisync:kognisync_pass@localhost:5434/kognisync_db

# Redis Configuration (Distributed Holds & Caching)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.5-flash-lite

# Google Maps / Routes API Configuration (Optional Cloud Provider)
# When GOOGLE_ROUTES_ENABLED is True and a valid GOOGLE_MAPS_API_KEY is supplied,
# KogniSync will enrich road journey segments using the Google Routes API v2.
# When disabled (default) or key is absent, KogniSync seamlessly uses deterministic geographic routing.
GOOGLE_ROUTES_ENABLED=False
GOOGLE_MAPS_API_KEY=

# Valhalla OpenStreetMap Routing Configuration (Optional, Self-Hosted Local Engine)
# When VALHALLA_ENABLED is True and Valhalla is running, KogniSync uses OpenStreetMap
# road and pedestrian routing without third-party cloud API credentials or quotas.
VALHALLA_ENABLED=False
VALHALLA_BASE_URL=http://localhost:8002
VALHALLA_TIMEOUT_SECONDS=3.0

# TomTom Orbis Traffic API v2 (Milestone M3.8)
# When TOMTOM_TRAFFIC_ENABLED is True and a valid TOMTOM_API_KEY is supplied,
# KogniSync fetches real-time road incidents via the TomTom Orbis Traffic API v2.
# When disabled or key is absent, KogniSync reports provider status honestly as BLOCKED (no fabrication).
TOMTOM_TRAFFIC_ENABLED=True
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com/maps/orbis/traffic/incidents/details
TOMTOM_TIMEOUT_SECONDS=3.0
TOMTOM_MAX_RETRIES=2
TOMTOM_MAX_REQUESTS_PER_ASSESSMENT=5

# GTFS Realtime Configuration (Milestone M3.8)
# When GTFS_REALTIME_ENABLED is True and an authorized official feed URL is provided,
# KogniSync consumes trip updates and service alerts.
# In absence of an authorized feed, capability discovery reports BLOCKED.
GTFS_REALTIME_ENABLED=False
GTFS_REALTIME_FEED_URL=
GTFS_REALTIME_API_KEY=
GTFS_REALTIME_TIMEOUT_SECONDS=5.0
GTFS_REALTIME_ALLOW_HTTP=False

# Data Freshness Thresholds (seconds) (Milestone M3.8)
FRESHNESS_ROAD_INCIDENT_SECONDS=1800
FRESHNESS_SERVICE_ALERT_SECONDS=3600
FRESHNESS_TRIP_UPDATE_SECONDS=300
FRESHNESS_VEHICLE_POSITION_SECONDS=60
